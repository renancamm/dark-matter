      { "library": "0Harmony", "member": "HarmonyLib.PatchClassProcessor::", "atCall": true, "caps": ["code-generation", "code-rewrite", "rewrite-outside-game", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "patching is Harmony's job; targets and patch methods are checked at the mod" },
      { "library": "0Harmony", "member": "HarmonyLib.PatchProcessor::", "atCall": true, "caps": ["code-generation", "code-rewrite", "rewrite-outside-game", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "patching is Harmony's job; targets and patch methods are checked at the mod" },
      { "library": "0Harmony", "member": "HarmonyLib.ReversePatcher::", "atCall": true, "caps": ["code-generation", "code-rewrite", "rewrite-outside-game", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "a reverse patch copies a traced original into a mod stub (a reflection sink at the mod)" },
      { "library": "0Harmony", "member": "HarmonyLib.HarmonyMethod::", "atCall": true, "caps": ["code-generation", "code-rewrite", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "wraps a patch method; its target must be traced at the mod (reflection sink)" },
      // Harmony's patch attributes: their constructors only store the target (the (typeName,
