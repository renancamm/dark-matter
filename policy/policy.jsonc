      { "library": "0Harmony", "member": "HarmonyLib.HarmonyDelegate::", "atCall": true, "caps": ["code-generation", "code-rewrite", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "attribute constructor stores the target; decoded from the attribute value at the mod" },
