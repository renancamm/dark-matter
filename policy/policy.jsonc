      { "library": "0Harmony", "member": "HarmonyLib.PatchClassProcessor::", "atCall": true, "caps": ["code-generation", "code-rewrite", "rewrite-outside-game", "raw-memory", "native-code", "dynamic-load", "unresolved-reflection", "bounded-reflection", "unclassified-reference"], "reason": "patching is Harmony's job; targets and patch methods are checked at the mod" },
