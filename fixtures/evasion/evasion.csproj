<Project Sdk="Microsoft.NET.Sdk">
  <!-- One assembly per case: dotnet build -p:Case=Dyn. Without a Case, all cases build into
       one assembly (the original probe). The Harmony cases reference the stand-in under Harmony's
       real assembly name (0Harmony), as mods do: the check models Harmony only for members that
       live there (policy 12), not for types of the same name compiled into the mod. -->
  <PropertyGroup>
    <Case Condition="'$(Case)' == ''">All</Case>
    <AssemblyName>Evasion.$(Case)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- The per-case properties (and the test harness's per-case output folders) stay with the case,
       so the referenced stand-ins build once, not once per case. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>Case;OutDir;IntermediateOutputPath</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Compile Include="cases/*.cs" Condition="'$(Case)' == 'All'" />
    <Compile Include="cases/$(Case).cs" Condition="'$(Case)' != 'All'" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../harmony-patch/stub/harmony-patch-stub.csproj" />
  </ItemGroup>
</Project>
