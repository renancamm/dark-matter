<Project Sdk="Microsoft.NET.Sdk">
  <!-- One assembly per case: dotnet build -p:Case=MemberArrayMod. Ordinary reflection the check
       traces since policy 10 (benign controls). References the Harmony stand-in (0Harmony) and the
       game stand-in (KSA), like a mod built against the real ones; a case that uses neither does
       not reference them in its metadata. -->
  <PropertyGroup>
    <Case Condition="'$(Case)' == ''">MemberArrayMod</Case>
    <AssemblyName>ReflectionPrecision.$(Case)</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- The per-case properties (and the test harness's per-case output folders) stay with the case,
       so the referenced stand-ins build once, not once per case. -->
  <ItemDefinitionGroup>
    <ProjectReference>
      <GlobalPropertiesToRemove>Case;OutDir;IntermediateOutputPath</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>
  <ItemGroup>
    <Compile Include="cases/$(Case).cs" />
    <ProjectReference Include="../harmony-patch/stub/harmony-patch-stub.csproj" />
    <ProjectReference Include="../game-api/stub/game-api-stub.csproj" />
  </ItemGroup>
</Project>
